{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "人生攻略库桌面端的最小本地权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:allow-restart",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "sql:default",
    "sql:allow-execute",
    "updater:default"
  ]
}
